// Cloudflare settings for ionutcm.com: static site, already built into ./public (run tools/build.py before committing).
{
  "name": "ionutcm-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
